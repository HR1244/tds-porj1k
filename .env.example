# Provide your Telegram Bot token from @BotFather
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Provide an API key for your LLM (OpenAI or proxy). 
# TDS courses often use an AIPROXY_TOKEN which works as an OpenAI token.
LLM_API_KEY=your_llm_api_key

# (Optional) If you are using a proxy or alternate provider, specify its base URL.
# BASE_URL=https://aiproxy.sanand.workers.dev/openai/v1

# (Optional) If you are using Render or another host, you can set PUBLIC_URL. 
# Otherwise, it falls back to http://localhost:8000 for local testing.
# PUBLIC_URL=https://your-app.onrender.com
